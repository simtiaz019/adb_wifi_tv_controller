[Unit]
Description=Multi-TV Telegram monitor and remote
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Environment=HOME=/root
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/haier-tv-monitor.env
ExecStart=/usr/bin/python3 /opt/haier-tv-monitor/haier_tv_bot.py
WorkingDirectory=/opt/haier-tv-monitor
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
