# Copy to /etc/tv-hub.env; systemd loads this file.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_PRIVATE_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_PRIVATE_CHAT_ID
TV_NAME="Haier MatrixTV CE"
TV_IP=192.168.1.243
TV_ADB_PORTS=36683,5555
TV2_NAME="Mi Box 3"
TV2_IP=192.168.1.149
TV2_ADB_PORTS=5555
POLL_SECONDS=15
STATE_FILE=/var/lib/tv-hub/state.json

# LAN remote alongside existing Telegram controls and notifications.
WEB_HOST=0.0.0.0
WEB_PORT=8080
TELEGRAM_REMOTE_ENABLED=1

# Add devices using the next number; gaps are allowed. Example:
# TV3_NAME="Bedroom TV"
# TV3_IP=192.168.1.150
# TV3_ADB_PORTS=5555
