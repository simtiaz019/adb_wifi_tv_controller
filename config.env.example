TELEGRAM_BOT_TOKEN=8931008058:AAEwjbzhYSWZPNF_8BzyxmTPAUwh2mI4f1M
TELEGRAM_CHAT_ID=446496080

TV_NAME="Haier MatrixTV CE"
TV_IP=192.168.1.243
TV_ADB_PORTS=5555
TV2_NAME="Mi Box 3"
TV2_IP=192.168.1.149
TV2_ADB_PORTS=5555
POLL_SECONDS=15
# Connectivity alert hysteresis: tolerate brief ADB/Wi-Fi sleep flaps.
CONNECTION_FAILURE_CONFIRMATIONS=5
CONNECTION_RECOVERY_CONFIRMATIONS=3
STATE_FILE=/var/lib/tv-hub/state.json

# LAN remote alongside existing Telegram controls and notifications.
WEB_HOST=0.0.0.0
WEB_PORT=8080
TELEGRAM_REMOTE_ENABLED=1

# Add devices using the next number; gaps are allowed. Example:
# TV3_NAME="Bedroom TV"
# TV3_IP=192.168.1.150
# TV3_ADB_PORTS=5555

# Foreground application monitoring (same Telegram bot and durable queue).
APP_MONITOR_ENABLED=true
APP_MONITOR_INTERVAL=15
APP_MONITOR_CONFIRMATIONS=2
APP_MONITOR_TELEGRAM=true
APP_HISTORY_LIMIT=500
TZ=Asia/Dhaka
TV_APP_MONITOR_ENABLED=true
TV2_APP_MONITOR_ENABLED=true
# Optional JSON mapping merged over built-in friendly names:
# APP_NAME_MAP='{"com.example.player":"My Player"}'

# Optional Live View. Install dependencies with install-live.sh first.
LIVE_VIEW_ENABLED=true
LIVE_VIEW_MAX_FPS=15
LIVE_VIEW_MAX_WIDTH=1280
LIVE_VIEW_BITRATE=2000000
LIVE_VIEW_IDLE_TIMEOUT=60
LIVE_VIEW_MAX_CONCURRENT_DEVICES=1
LIVE_VIEW_MAX_VIEWERS=4
LIVE_VIEW_STARTUP_TIMEOUT=30
LIVE_VIEW_USER=viewer
# Set a private password of at least 16 characters in /etc/tv-hub.env:
LIVE_VIEW_PASSWORD=Zbang@987_big#Zsx1mkl3_
# Haier capture is known to be unavailable; remote and monitoring still work.
TV_LIVE_VIEW_ENABLED=true
TV2_LIVE_VIEW_ENABLED=true
